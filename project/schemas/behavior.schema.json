{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biogen.local/schemas/behavior.schema.json",
  "title": "Behavior",
  "description": "Ethogram behavior object linking selection to executable motion primitives (프롬프트 §8, §10). Behavior must reference locomotion action primitives (규칙 12/13).",
  "type": "object",
  "required": ["behavior_id", "label", "action_primitive_ids"],
  "additionalProperties": true,
  "properties": {
    "behavior_id": {"type": "string"},
    "label": {"type": "string"},
    "preconditions": {"type": "array"},
    "sensor_inputs": {"type": "array", "items": {"type": "string"}},
    "internal_drive_effects": {"type": "object"},
    "trigger_model": {"type": "object"},
    "duration_distribution": {
      "type": "object",
      "properties": {
        "dist": {"enum": ["fixed", "normal", "lognormal", "exponential", "uniform"]},
        "params": {"type": "object"}
      }
    },
    "transition_targets": {"type": "array"},
    "action_primitive_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "utility": {
      "type": "object",
      "description": "Utility scoring weights over normalized drive/sensor features.",
      "additionalProperties": {"type": "number"}
    },
    "energy_cost": {"type": "object"},
    "social_context": {"type": "array"},
    "environment_constraints": {"type": "object"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
