{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biogen.local/schemas/species_preset.schema.json",
  "title": "SpeciesPreset",
  "description": "Species preset = CladeBase + MorphotypeBase + SpeciesDelta + ContextDelta + IndividualSeed (프롬프트 §2, §8). Taxon-agnostic: no taxon literal in required field names.",
  "type": "object",
  "required": ["preset_version", "taxon", "context", "coordinate_system", "parameter_hierarchy", "provenance"],
  "additionalProperties": true,
  "properties": {
    "preset_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "kind": {"enum": ["clade_base", "morphotype_base", "species_delta", "resolved_preset"]},
    "taxon": {
      "type": "object",
      "required": ["taxon_id", "accepted_scientific_name", "rank"],
      "properties": {
        "taxon_id": {"type": "string", "minLength": 1},
        "accepted_scientific_name": {"type": "string"},
        "rank": {"type": "string"},
        "synonyms": {"type": "array", "items": {"type": "string"}},
        "classification": {"type": "array", "items": {"type": "string"}},
        "source_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "sex": {"enum": ["unknown", "female", "male", "other", "not_applicable"]},
        "life_stage": {"type": "string"},
        "population": {"type": "string"},
        "season": {"type": "string"},
        "condition": {"type": "string"},
        "reference_size_si": {"type": "number", "minimum": 0}
      }
    },
    "coordinate_system": {
      "type": "object",
      "required": ["symmetry_type"],
      "properties": {
        "symmetry_type": {"enum": ["bilateral", "radial", "segmented", "modular", "colonial", "other"]},
        "frame_definition": {"type": "object"},
        "normalized_scale_definition": {"type": "string"}
      }
    },
    "parameter_hierarchy": {
      "type": "object",
      "required": ["clade_base_id", "morphotype_base_id"],
      "properties": {
        "clade_base_id": {"type": "string"},
        "morphotype_base_id": {"type": "string"},
        "species_delta_id": {"type": "string"},
        "context_delta_ids": {"type": "array", "items": {"type": "string"}},
        "individual_seed_policy": {"type": "string"}
      }
    },
    "morphometrics": {"type": "object"},
    "anatomy": {"type": "object"},
    "external_structures": {"type": "object"},
    "appearance": {"type": "object"},
    "sensory_system": {"type": "object"},
    "locomotion": {"type": "object"},
    "behavior": {"type": "object"},
    "ecology": {"type": "object"},
    "render_and_simulation_lod": {"type": "array"},
    "validation": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["evidence_refs"],
      "properties": {
        "evidence_refs": {"type": "array"},
        "license_refs": {"type": "array"},
        "build_hash": {"type": "string"},
        "generated_at": {"type": "string"}
      }
    }
  },
  "$defs": {
    "measured_value": {
      "type": "object",
      "required": ["value", "evidence_class"],
      "properties": {
        "value": {},
        "unit": {"type": "string"},
        "min_value": {"type": "number"},
        "max_value": {"type": "number"},
        "evidence_class": {"enum": ["Measured", "Derived", "Inferred", "ArtistAuthored"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
